# GEMINI_API_KEY: Server-side only. Required for Gemini Vision API calls.
# Never prefix with VITE_. AI Studio injects this at runtime from Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# SUPABASE DATABASE & AUTH CONFIGURATION (Browser-Safe Public Variables)
# -----------------------------------------------------------------------------
# These two VITE_* variables are safe to expose in the browser bundle ONLY
# because Row Level Security (RLS) is enabled on all database tables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# -----------------------------------------------------------------------------
# SERVER-SIDE ONLY SECRETS (NEVER expose to browser / NEVER prefix with VITE_)
# -----------------------------------------------------------------------------
# Used only in server.ts or trusted CLI admin scripts. Bypasses RLS.
# Leave unset unless performing trusted backend administration.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional server-side Google Cloud Vision API key for Document Text OCR
GOOGLE_CLOUD_VISION_API_KEY=""
