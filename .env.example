# -----------------------------------------------------------------------------
# GOOGLE CLOUD VISION API (Required for Register & Student Roster OCR)
# -----------------------------------------------------------------------------
# Server-side only secret. NEVER prefix with VITE_.
# Add this in Vercel -> Project Settings -> Environment Variables.
GOOGLE_CLOUD_VISION_API_KEY=""

# -----------------------------------------------------------------------------
# GEMINI API (Optional: AI Nigerian-context Name Correction during Enrollment)
# -----------------------------------------------------------------------------
# Server-side only secret. NEVER prefix with VITE_.
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# SUPABASE DATABASE & AUTH CONFIGURATION (Optional for Remote Persistence)
# -----------------------------------------------------------------------------
# Safe to expose to the browser bundle ONLY because Row Level Security (RLS)
# is enabled on all Supabase tables.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
